{
  "name": "scadacraft-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for ScadaCraft: build P&ID pages with OpenBridge widgets, bind tags, manage server tags",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-docs.mjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node test/parity.mjs && node test/e2e.mjs",
    "clean": "rm -rf dist docs"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xmldom/xmldom": "^0.9.12",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "bin": {
    "scadacraft-mcp-server": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  }
}
