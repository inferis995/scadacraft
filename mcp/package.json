{
  "name": "scadacraft-mcp-server",
  "version": "0.5.0",
  "description": "MCP server for ScadaCraft: devices, tags, alarms, P&ID pages with OpenBridge widgets, live and historical data, project export/import",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "scada",
    "hmi",
    "fuxa",
    "scadacraft",
    "openbridge",
    "modbus",
    "opc-ua",
    "industrial-automation"
  ],
  "author": "Giovanni Addeo <addeoninja@gmail.com> (NET CARING S.R.L.)",
  "homepage": "https://github.com/inferis995/scadacraft/tree/main/mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/inferis995/scadacraft.git",
    "directory": "mcp"
  },
  "bugs": {
    "url": "https://github.com/inferis995/scadacraft/issues"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-docs.mjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node test/parity.mjs && node test/http-auth.mjs && node test/e2e.mjs && node test/e2e-widgets.mjs && node test/e2e-library.mjs && node test/e2e-cwp.mjs && node test/e2e-interaction.mjs && node test/e2e-plant.mjs && node test/e2e-admin.mjs",
    "clean": "rm -rf dist docs"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xmldom/xmldom": "^0.9.12",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "modbus-serial": "^8.0.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "bin": {
    "scadacraft-mcp-server": "dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ]
}
